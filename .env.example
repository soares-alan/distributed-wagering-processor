NODE_ENV=development

POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LocalStack SQS; the queue-creation command prints the resolved FIFO URL.
AWS_REGION=us-east-1
SQS_INBOX_QUEUE_URL=
SQS_DLQ_QUEUE_URL=
# The Version2 documents do not define the separate outbox destination queue.
SQS_QUEUE_URL=
SQS_ENDPOINT_URL=http://localhost:4566
SQS_CONSUMER_NAME=wager-transaction-consumer
OUTBOX_POLL_INTERVAL_MS=1000
SQS_MAX_MESSAGES_PER_POLL=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=300000
OUTBOX_BATCH_SIZE=10
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MINUTES=60
PENDING_REFERENCE_BASE_BACKOFF_MS=1000
PENDING_REFERENCE_MAX_BACKOFF_MS=60000
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
